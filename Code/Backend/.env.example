PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/tttn_db
# Generate a private random value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
FRONTEND_API_BASE_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
AUTH_COOKIE_SAME_SITE=lax
# Production defaults to SameSite=None and Secure. If explicitly configured in production,
# use AUTH_COOKIE_SAME_SITE=none when the frontend and API are on different sites.
# Set AUTH_COOKIE_SECURE=true when using HTTPS outside production mode.
AUTH_COOKIE_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FRONTEND_RESET_URL=http://127.0.0.1:5500/Code/Frontend/html/auth/reset-password.html

# Ollama running on the same machine as the backend
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
